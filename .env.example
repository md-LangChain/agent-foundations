# --- LangSmith (tracing / sandbox; this is your workspace key) ---
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<langsmith-api-key>"
LANGSMITH_PROJECT="agent-foundations"

# =============================================================================
# LANGSMITH - GATEWAY
# Service key from the assigned machine (`echo $LC_GATEWAY_KEY`).
# Different from LANGSMITH_API_KEY. Not a platform.openai.com key.
# =============================================================================
LC_GATEWAY_KEY="<your_lc_gateway_key>"

OPENAI_BASE_URL="https://gateway.smith.langchain.com/openai/v1"
OPENAI_API_KEY="<your_lc_gateway_key>"
